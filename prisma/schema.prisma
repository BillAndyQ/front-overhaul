// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Elimina la línea 'url = env("DATABASE_URL")'
}

model Users {
  id_user      Int    @id @default(autoincrement())
  username String @unique
  password String
  rol String
  
  @@map("users")
}

// Libro de Reclamaciones. Tabla creada con prisma/sql/reclamos.sql
// (no usar `prisma db push`: borraría tablas de otros servicios).
model Reclamo {
  numero                  Int      @id @default(autoincrement())
  fecha_emision           DateTime @default(now()) @db.Timestamptz(3)

  nombres                 String
  apellidos               String
  tipo_documento          String
  numero_documento        String
  celular                 String
  departamento            String
  provincia               String
  distrito                String
  direccion               String
  referencia              String
  correo                  String
  menor_edad              Boolean  @default(false)
  apoderado_nombre        String?
  apoderado_documento     String?

  tipo_consumo            String
  numero_pedido           String
  fecha_incidente         DateTime @db.Date
  monto                   Decimal  @db.Decimal(12, 2)
  descripcion_bien        String

  tipo_reclamo            String
  detalle                 String
  pedido                  String

  observaciones_proveedor String?
  estado                  String   @default("pendiente")
  updated_at              DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("reclamos")
}
